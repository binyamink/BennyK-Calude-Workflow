# ==============================================================================
# .gitignore for Academic Claude Code Projects
# ==============================================================================

# LaTeX build artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.nav
*.out
*.snm
*.toc
*.vrb
*.synctex.gz
*.run.xml
*-blx.bib

# Compiled PDFs (uncomment to track specific PDFs)
# *.pdf

# Python
__pycache__/
*.pyc
*.pyo

# R
.Rproj.user/
.Rhistory
.RData
.Rdata

# OS files
.DS_Store
Thumbs.db

# Claude Code local files (not shared across machines)
.claude/settings.local.json
.claude/state/
CLAUDE.local.md

# IDE
.vscode/
.idea/
*.swp
*.swo
*~


# Output artifacts — uncomment lines below based on your preference
# *.rds
# output/**/*.rds

# Data files — large datasets should not be tracked
# Small reference datasets can be force-added: git add -f data/raw/small_file.csv
*.dta
*.csv
*.tsv
*.parquet
*.arrow
*.feather
*.fst
*.h5
*.hdf5
*.sas7bdat
*.sav
*.por

# Spatial data
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.geojson
*.gpkg
*.tif
*.tiff

# Stata artifacts
*.smcl
*.sthlp

# Julia artifacts
*.jld2
Manifest.toml
